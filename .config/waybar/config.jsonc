[
  {
    "name": "top",
    "layer": "top",
    "position": "top",
    "height": 25,
    "exclusive": false,
    "modules-left": ["custom/powermenu", "custom/cava", "pulseaudio", "custom/playerctl"],
    "modules-right": ["tray", "clock"],

    "custom/powermenu": {
      "format": "󰐥",
      "on-click": "/home/carens/.config/sway/scripts/powermenu.sh",
      "tooltip": false
    },
    "custom/cava": {
      "exec": "/home/carens/.config/sway/scripts/cava.sh",
      "tail": true,
      "format": "{}",
      "escape": false,
      "tooltip": false
    },
    "pulseaudio": {
      "format": "󰕾 {volume}%",
      "format-muted": "󰝟 mute",
      "tooltip": false
    },
    "custom/playerctl": {
      "exec": "/home/carens/.config/sway/scripts/playerctl.sh",
      "interval": 1,
      "format": "{}",
      "escape": false,
      "on-click": "playerctl play-pause",
      "on-click-middle": "playerctl previous",
      "on-click-right": "playerctl next",
      "tooltip": false
    },
    "tray": {"icon-size": 16, "spacing": 8},
    "clock": {
      "format": "<span foreground='#e55561'>󰅐</span> {:%d %b %H:%M}",
      "tooltip": false
    }
  },
  {
    "name": "bottom",
    "layer": "top",
    "position": "bottom",
    "height": 25,
    "exclusive": false,
    "modules-left": ["sway/workspaces"],
    "modules-right": ["cpu", "memory", "custom/temperature"],

    "sway/workspaces": {
      "disable-scroll": true,
      "format": "{name}"
    },
    "cpu": {
      "format": "<span foreground='#e55561'>C: </span>{usage}%",
      "interval": 1,
      "tooltip": false
    },
    "memory": {
      "format": "<span foreground='#e55561'>M: </span>{used}/{total}",
      "interval": 1,
      "tooltip": false
    },
    "custom/temperature": {
      "exec": "/home/carens/.config/sway/scripts/temperature.sh",
      "interval": 1,
      "format": "{}",
      "escape": false,
      "tooltip": false
    }
  }
]
